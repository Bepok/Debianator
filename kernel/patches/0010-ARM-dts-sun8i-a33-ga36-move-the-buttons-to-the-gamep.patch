-/* The analog stick MCU; its driver comes in v1.1. */
+/* The analog sticks come from an MCU on UART1; the gamepad also owns the buttons, so both are one input device. */
 &uart1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart1_pg_pins>;
 	status = "okay";
+
+	mcu {
+		compatible = "gameconsole,ga36-gamepad";
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_pins>;
+		poll-interval = <10>;
+
+		button-south {
+			label = "SOUTH";
+			linux,code = <BTN_SOUTH>;
+			gpios = <&pio 4 13 GPIO_ACTIVE_LOW>; /* PE13 */
+		};
+
+		button-east {
+			label = "EAST";
+			linux,code = <BTN_EAST>;
+			gpios = <&pio 4 12 GPIO_ACTIVE_LOW>; /* PE12 */
+		};
+
+		button-north {
+			label = "NORTH";
+			linux,code = <BTN_NORTH>;
+			gpios = <&pio 4 11 GPIO_ACTIVE_LOW>; /* PE11 */
+		};
+
+		button-west {
+			label = "WEST";
+			linux,code = <BTN_WEST>;
+			gpios = <&pio 4 10 GPIO_ACTIVE_LOW>; /* PE10 */
+		};
+
+		button-tl {
+			label = "TL";
+			linux,code = <BTN_TL>;
+			gpios = <&pio 4 15 GPIO_ACTIVE_LOW>; /* PE15 */
+		};
+
+		button-tr {
+			label = "TR";
+			linux,code = <BTN_TR>;
+			gpios = <&pio 4 17 GPIO_ACTIVE_LOW>; /* PE17 */
+		};
+
+		button-tl2 {
+			label = "TL2";
+			linux,code = <BTN_TL2>;
+			gpios = <&pio 4 14 GPIO_ACTIVE_LOW>; /* PE14 */
+		};
+
+		button-tr2 {
+			label = "TR2";
+			linux,code = <BTN_TR2>;
+			gpios = <&pio 4 16 GPIO_ACTIVE_LOW>; /* PE16 */
+		};
+
+		button-select {
+			label = "SELECT";
+			linux,code = <BTN_SELECT>;
+			gpios = <&pio 4 5 GPIO_ACTIVE_LOW>; /* PE5 */
+		};
+
+		button-start {
+			label = "START";
+			linux,code = <BTN_START>;
+			gpios = <&pio 4 4 GPIO_ACTIVE_LOW>; /* PE4 */
+		};
+
+		button-thumbl {
+			label = "THUMBL";
+			linux,code = <BTN_THUMBL>;
+			gpios = <&pio 1 3 GPIO_ACTIVE_LOW>; /* PB3 */
+		};
+
+		button-thumbr {
+			label = "THUMBR";
+			linux,code = <BTN_THUMBR>;
+			gpios = <&pio 1 2 GPIO_ACTIVE_LOW>; /* PB2 */
+		};
+
+		button-up {
+			label = "DPAD-UP";
+			linux,code = <BTN_DPAD_UP>;
+			gpios = <&pio 4 9 GPIO_ACTIVE_LOW>; /* PE9 */
+		};
+
+		button-down {
+			label = "DPAD-DOWN";
+			linux,code = <BTN_DPAD_DOWN>;
+			gpios = <&pio 4 8 GPIO_ACTIVE_LOW>; /* PE8 */
+		};
+
+		button-left {
+			label = "DPAD-LEFT";
+			linux,code = <BTN_DPAD_LEFT>;
+			gpios = <&pio 4 7 GPIO_ACTIVE_LOW>; /* PE7 */
