From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bepok <wojtekjakubiszyn@gmail.com>
Date: Wed, 14 Oct 2026 17:09:12 +0200
Subject: [PATCH 6/9] drm/panel: nv3051d: make lane count and init sequence
 per-panel

All supported panels use four DSI lanes and share one init sequence.
Move both into the panel info so a panel with a different lane count
and its own vendor sequence can be added. No functional change for the
existing panels.

Signed-off-by: Bepok <wojtekjakubiszyn@gmail.com>
---
 drivers/gpu/drm/panel/panel-newvision-nv3051d.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-newvision-nv3051d.c b/drivers/gpu/drm/panel/panel-newvision-nv3051d.c
index 22560384e..09262a066 100644
--- a/drivers/gpu/drm/panel/panel-newvision-nv3051d.c
+++ b/drivers/gpu/drm/panel/panel-newvision-nv3051d.c
@@ -23,12 +23,16 @@
 #include <drm/drm_modes.h>
 #include <drm/drm_panel.h>
 
+struct panel_nv3051d;
+
 struct nv3051d_panel_info {
 	const struct drm_display_mode *display_modes;
 	unsigned int num_modes;
 	u16 width_mm, height_mm;
 	u32 bus_flags;
 	u32 mode_flags;
+	unsigned int lanes;
+	int (*init_sequence)(struct panel_nv3051d *ctx);
 };
 
 struct panel_nv3051d {
@@ -289,7 +293,7 @@ static int panel_nv3051d_prepare(struct drm_panel *panel)
 	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
 	msleep(20);
 
-	ret = panel_nv3051d_init_sequence(ctx);
+	ret = ctx->panel_info->init_sequence(ctx);
 	if (ret < 0) {
 		dev_err(ctx->dev, "Panel init sequence failed: %d\n", ret);
 		goto disable_vdd;
@@ -389,7 +393,7 @@ static int panel_nv3051d_probe(struct mipi_dsi_device *dsi)
 
 	mipi_dsi_set_drvdata(dsi, ctx);
 
-	dsi->lanes = 4;
+	dsi->lanes = ctx->panel_info->lanes;
 	dsi->format = MIPI_DSI_FMT_RGB888;
 	dsi->mode_flags = ctx->panel_info->mode_flags;
 
@@ -495,6 +499,8 @@ static const struct nv3051d_panel_info nv3051d_rg351v_info = {
 	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
 		      MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET |
 		      MIPI_DSI_CLOCK_NON_CONTINUOUS,
+	.lanes = 4,
+	.init_sequence = panel_nv3051d_init_sequence,
 };
 
 static const struct nv3051d_panel_info nv3051d_rg353p_info = {
@@ -505,6 +511,8 @@ static const struct nv3051d_panel_info nv3051d_rg353p_info = {
 	.bus_flags = DRM_BUS_FLAG_DE_LOW | DRM_BUS_FLAG_PIXDATA_DRIVE_NEGEDGE,
 	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
 		      MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET,
+	.lanes = 4,
+	.init_sequence = panel_nv3051d_init_sequence,
 };
 
 static const struct nv3051d_panel_info nv3051d_rk2023_info = {
@@ -515,6 +523,8 @@ static const struct nv3051d_panel_info nv3051d_rk2023_info = {
 	.bus_flags = DRM_BUS_FLAG_DE_LOW | DRM_BUS_FLAG_PIXDATA_DRIVE_NEGEDGE,
 	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
 		      MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET,
+	.lanes = 4,
+	.init_sequence = panel_nv3051d_init_sequence,
 };
 
 static const struct of_device_id newvision_nv3051d_of_match[] = {
