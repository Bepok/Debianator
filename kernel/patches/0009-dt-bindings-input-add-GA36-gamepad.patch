From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bepok <wojtekjakubiszyn@gmail.com>
Date: Mon, 19 Oct 2026 05:36:50 +0200
Subject: [PATCH 09/10] dt-bindings: input: add GA36 gamepad

The GA36 handheld's buttons are GPIOs and its two analog sticks are read by
a microcontroller on a UART. Describe them as one gamepad, a child of that
UART, so buttons and sticks form a single input device.

Signed-off-by: Bepok <wojtekjakubiszyn@gmail.com>
---
 .../input/gameconsole,ga36-gamepad.yaml       | 69 +++++++++++++++++++
 1 file changed, 69 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/gameconsole,ga36-gamepad.yaml

diff --git a/Documentation/devicetree/bindings/input/gameconsole,ga36-gamepad.yaml b/Documentation/devicetree/bindings/input/gameconsole,ga36-gamepad.yaml
new file mode 100644
index 000000000..0cc356199
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/gameconsole,ga36-gamepad.yaml
@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/gameconsole,ga36-gamepad.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: GameConsole R36S GA36 gamepad
+
+maintainers:
+  - Bepok <wojtekjakubiszyn@gmail.com>
+
+description:
+  The controls of the GA36 handheld as one gamepad. The buttons are GPIOs
+  polled by the host. The two analog sticks are read by a microcontroller
+  that streams their positions over the UART this node is a child of.
+
+allOf:
+  - $ref: /schemas/serial/serial-peripheral-props.yaml#
+  - $ref: input.yaml#
+
+properties:
+  compatible:
+    const: gameconsole,ga36-gamepad
+
+  poll-interval: true
+
+patternProperties:
+  "^button-[a-z0-9-]+$":
+    type: object
+    $ref: input.yaml#
+
+    properties:
+      gpios:
+        maxItems: 1
+
+      label:
+        description: Descriptive name of the button.
+
+      linux,code: true
+
+    required:
+      - gpios
+      - linux,code
+
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - poll-interval
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/input/input.h>
+
+    serial {
+        mcu {
+            compatible = "gameconsole,ga36-gamepad";
+            poll-interval = <10>;
+
+            button-south {
+                label = "SOUTH";
+                linux,code = <BTN_SOUTH>;
+                gpios = <&pio 4 13 GPIO_ACTIVE_LOW>;
+            };
+        };
+    };
